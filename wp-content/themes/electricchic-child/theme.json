{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "black",
					"color": "#0b0b0d",
					"name": "שחור"
				},
				{
					"slug": "surface",
					"color": "#141418",
					"name": "משטח"
				},
				{
					"slug": "surface-2",
					"color": "#1c1c21",
					"name": "משטח מוגבה"
				},
				{
					"slug": "line",
					"color": "#3a3a40",
					"name": "קו"
				},
				{
					"slug": "grey",
					"color": "#8a8a92",
					"name": "אפור"
				},
				{
					"slug": "off-white",
					"color": "#e8e8e6",
					"name": "לבן שבור"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "לבן"
				},
				{
					"slug": "lime",
					"color": "#ccff00",
					"name": "ליים"
				},
				{
					"slug": "lime-dim",
					"color": "#a8d400",
					"name": "ליים כהה"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Heebo",
					"fontFamily": "Heebo, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.9375rem",
					"name": "קטן"
				},
				{
					"slug": "medium",
					"size": "1.0625rem",
					"name": "רגיל"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "גדול"
				},
				{
					"slug": "x-large",
					"size": "2.75rem",
					"name": "ענק"
				},
				{
					"slug": "xx-large",
					"size": "3.75rem",
					"name": "כותרת ראשית"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "40",
					"size": "2rem",
					"name": "3"
				},
				{
					"slug": "50",
					"size": "3rem",
					"name": "4"
				},
				{
					"slug": "60",
					"size": "4rem",
					"name": "5"
				},
				{
					"slug": "70",
					"size": "6rem",
					"name": "6"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--black)",
			"text": "var(--wp--preset--color--off-white)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "800",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em"
				},
				"color": {
					"text": "var(--wp--preset--color--white)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--lime)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--lime)",
					"text": "var(--wp--preset--color--black)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		}
	}
}
