{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "820px", "wideSize": "1280px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "cream", "color": "#faf8f5", "name": "קרם" },
				{ "slug": "ivory", "color": "#f3f0eb", "name": "שנהב" },
				{ "slug": "sand", "color": "#e8e3dc", "name": "חול" },
				{ "slug": "stone", "color": "#a69f95", "name": "אבן" },
				{ "slug": "graphite", "color": "#4a4640", "name": "גרפיט" },
				{ "slug": "charcoal", "color": "#2c2926", "name": "פחם" },
				{ "slug": "brass", "color": "#b8976a", "name": "פליז" },
				{ "slug": "brass-dark", "color": "#8f7343", "name": "פליז כהה" },
				{ "slug": "white", "color": "#ffffff", "name": "לבן" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Heebo",
					"fontFamily": "Heebo, system-ui, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Frank Ruhl Libre",
					"fontFamily": "'Frank Ruhl Libre', Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "קטן" },
				{ "slug": "medium", "size": "1.0625rem", "name": "רגיל" },
				{ "slug": "large", "size": "1.5rem", "name": "גדול" },
				{ "slug": "x-large", "size": "2.75rem", "name": "ענק" },
				{ "slug": "xx-large", "size": "3.75rem", "name": "כותרת ראשית" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "1" },
				{ "slug": "30", "size": "1rem", "name": "2" },
				{ "slug": "40", "size": "2rem", "name": "3" },
				{ "slug": "50", "size": "3rem", "name": "4" },
				{ "slug": "60", "size": "4rem", "name": "5" },
				{ "slug": "70", "size": "6rem", "name": "6" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--graphite)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				"color": { "text": "var(--wp--preset--color--charcoal)" }
			},
			"link": { "color": { "text": "var(--wp--preset--color--brass-dark)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--charcoal)", "text": "var(--wp--preset--color--cream)" },
				"border": { "radius": "0" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } }
			}
		},
		"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } }
	}
}
